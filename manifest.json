{
 "update_url": "https://clients2.google.com/service/update2/crx",
 "manifest_version": 3,
 "name": "__MSG_appName__",
 "short_name": "MeetMemo",
 "description": "__MSG_appDesc__",
 "version": "3.1.7372",
 "default_locale": "en",
 "action": {
  "default_popup": "auth.html",
  "default_title": "Manage MeetMemo's options"
 },
 "background": {
  "service_worker": "service-worker.js"
 },
 "icons": {
  "16": "favicon-16.png",
  "32": "favicon-32.png",
  "48": "logo-48.png",
  "128": "logo-128.png"
 },
 "permissions": [
  "declarativeContent",
  "activeTab",
  "storage",
  "alarms",
  "scripting",
  "unlimitedStorage",
  "identity",
  "declarativeNetRequest"
 ],
 "host_permissions": [
  "*://meet.google.com/*-*-*",
  "https://meetmemo-api.onrender.com/*"
 ],
 "optional_host_permissions": [
  "*://*/*",
  "<all_urls>"
 ],
 "externally_connectable": {
  "matches": [
   "https://testfirebaseauth-f5df6.firebaseapp.com/*"
  ]
 },
 "declarative_net_request": {
  "rule_resources": [
   {
    "id": "block_hosted_meetmemo",
    "enabled": true,
    "path": "rules/block-hosted.json"
   }
  ]
 },
 "options_page": "options.html",
 "content_security_policy": {
  "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';"
 },
 "content_scripts": [
  {
   "matches": [
    "*://meet.google.com/*-*-*"
   ],
   "css": [
    "content.css"
   ],
   "js": [
    "content.js"
   ]
  },
  {
   "matches": [
    "*://meet.google.com/*-*-*"
   ],
   "js": [
    "rtcinjector.js"
   ],
   "run_at": "document_start"
  },
  {
   "matches": [
    "*://meet.google.com/*-*-*"
   ],
   "js": [
    "extension-auth/session.js",
    "extension-auth/localBridge.js",
    "extension-auth/links.js",
    "extension-auth/panelPrivacy.js",
    "sync/content.js"
   ],
   "run_at": "document_start"
  }
 ],
 "web_accessible_resources": [
  {
   "resources": [
    "lang/*.json",
    "*.svg",
    "rtcinjector.js",
    "*.inline.js"
   ],
   "matches": [
    "*://*/*"
   ]
  },
  {
   "resources": [
    "auth.html",
    "unavailable.html",
    "history.html",
    "settings.html",
    "help.html",
    "privacy.html"
   ],
   "matches": [
    "*://meet.google.com/*"
   ]
  }
 ],
 "key": ""
}
