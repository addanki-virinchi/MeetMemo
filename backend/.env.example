# Copy to .env.development / .env.production and fill in. Never commit real values.
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Comma-separated browser origins allowed to call this API.
# Extension origin looks like chrome-extension://<EXTENSION_ID>
ALLOWED_ORIGINS=chrome-extension://gnolicpkknhchlmmfgamghnjcbmpndlf

# --- Firebase Admin (service account) : SERVER ONLY ---
FIREBASE_PROJECT_ID=meetmemo-c7576
FIREBASE_CLIENT_EMAIL=REPLACE_firebase-adminsdk-xxxxx@meetmemo-c7576.iam.gserviceaccount.com
# Keep the quotes; newlines must be written as \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"
# Optional (present in the JSON; not required by firebase-admin)
FIREBASE_PRIVATE_KEY_ID=REPLACE
FIREBASE_CLIENT_ID=REPLACE
# Alternative to the three vars above: path to the JSON file (outside the repo).
# In production on Cloud Run/GCP prefer attached service identity and set neither.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Local development only ---
# Set to use the Firestore emulator instead of the real project, e.g. 127.0.0.1:8081
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# --- Google Sign-In (public identifier, not a secret) ---
# Client ID of the Google OAuth client used by the extension (type "Web application").
# The extension reads it from GET /v1/auth/config, so changing it needs no extension release.
GOOGLE_OAUTH_CLIENT_ID=REPLACE.apps.googleusercontent.com

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Email/password sign-in ---
# true (default) => /v1/auth/signup|login are enabled. false => 404; Google sign-in only.
AUTH_PASSWORD_ENABLED=true
# Required: Firebase Console > Project settings > General > "Web API Key" (public identifier)
FIREBASE_WEB_API_KEY=REPLACE

# --- Ask MeetMemo AI (Claude) : SERVER ONLY, SECRET ---
# Anthropic API key. Never put it in extension files. Without it the server still starts
# and Ask AI reports that it is not set up.
ANTHROPIC_API_KEY=REPLACE
# Optional
AI_ENABLED=true
AI_MODEL=claude-haiku-5-5
# Questions per user per 10 minutes
AI_RATE_LIMIT_PER_10MIN=20
# Live auto-answer (MeetMemo AI panel in a live meeting). Defaults to AI_MODEL.
AI_LIVE_MODEL=claude-haiku-5-5
# Answered-or-checked live questions per user per 10 minutes
AI_LIVE_RATE_LIMIT_PER_10MIN=60
